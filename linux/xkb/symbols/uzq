// Uzbek (yangi lotin alifbosi) — XKB symbols fayli
//
// 2026-yilgi alifbo islohotiga ko'ra kiritilayotgan Ö, Ğ, Ş, Ç harflari
// va tutuq belgisi (ʼ, U+02BC) uchun IKKITA variant mavjud:
//
// ── "basic"  (Q joylashuvi, turk "Q" klaviaturasidagi kabi) ───────────────
//   [  ->  ö / Ö        ]  ->  ğ / Ğ
//   ;  ->  ş / Ş        "'"  ->  ç / Ç        `  ->  ʼ
//
// ── "cw"  (harf tugmalari joylashuvi) ─────────────────────────────────────
//   c  ->  ç / Ç        w  ->  ş / Ş
//   ;  ->  ö / Ö        ,  ->  ğ / Ğ        `  ->  ʼ
//
// Ikkala variantda ham almashtirilgan tugmalarning ESKI belgilariga
// o'ng Alt (AltGr) bilan, ya'ni 3-/4-daraja orqali yetiladi.

// ───────────────────────── 1-variant: basic (o'zgarmagan) ─────────────────
xkb_symbols "basic" {
    include "us(basic)"
    name[Group1] = "New Uzbek (Latin)";

    key <TLDE> { [ U02BC,       asciitilde,  grave,        grave      ] }; // ʼ tutuq belgisi
    key <AD11> { [ odiaeresis,  Odiaeresis,  bracketleft,  braceleft  ] }; // Ö
    key <AD12> { [ gbreve,      Gbreve,      bracketright, braceright ] }; // Ğ
    key <AC10> { [ scedilla,    Scedilla,    semicolon,    colon      ] }; // Ş
    key <AC11> { [ ccedilla,    Ccedilla,    apostrophe,   quotedbl   ] }; // Ç

    // O'ng Alt (AltGr) — 3-daraja almashtirgichi. Shu qator bo'lmasa,
    // yuqoridagi 3- va 4-darajadagi eski belgilar yetib bo'lmaydigan qoladi.
    include "level3(ralt_switch)"
};

// ───────────────────────── 2-variant: cw (yangi) ──────────────────────────
xkb_symbols "cw" {
    include "us(basic)"
    name[Group1] = "New Uzbek (Latin) - C/W";

    key <TLDE> { [ U02BC,       asciitilde,  grave,        grave      ] }; // ʼ tutuq belgisi
    key <AB03> { [ ccedilla,    Ccedilla,    c,            C          ] }; // c -> ç
    key <AD02> { [ scedilla,    Scedilla,    w,            W          ] }; // w -> ş
    key <AC10> { [ odiaeresis,  Odiaeresis,  semicolon,    colon      ] }; // ; -> ö
    key <AB08> { [ gbreve,      Gbreve,      comma,        less       ] }; // , -> ğ

    include "level3(ralt_switch)"
};
